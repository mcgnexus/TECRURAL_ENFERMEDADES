# ============================================================================
# TECRURAL Diagnóstico — Variables de entorno
# Copia este archivo como .env.local (local) o configúralas en Vercel.
# ============================================================================

# --- Base de datos (Neon Postgres) ---
# Cadena de conexión completa (requerida para diagnósticos y leads)
DATABASE_URL=

# --- Proveedores de IA (SOLO servidor; nunca exponer al cliente) ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- Contacto comercial ---
# Número de WhatsApp de TecRural en formato internacional, SOLO dígitos
# (ej: 34 + número). Sin esta variable, los botones de WhatsApp se ocultan
# y el formulario de leads sigue funcionando.
NEXT_PUBLIC_TECRURAL_WHATSAPP=

# --- Aviso de lead nuevo (opcional pero recomendado) ---
# Telegram: token del bot (@BotFather) y chat destino. Es el canal principal
# porque el técnico mira el móvil, así que el lead se atiende en segundos.
# Se envía un mensaje con el resumen y un botón al panel.
# Para probarlo: https://api.telegram.org/bot<TOKEN>/getMe
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook genérico: alternativa o complemento de Telegram, para cuando el
# destino sea la API de WhatsApp Business, n8n/Make/Zapier o un endpoint
# propio. Recibe el payload completo en JSON. Si no hay ninguna de las dos
# variables, el lead se guarda igualmente y solo queda en el panel.
LEAD_WEBHOOK_URL=
# Secreto opcional para firmar el cuerpo (HMAC-SHA256). Si se define, el
# destino recibe la cabecera X-TecRural-Signature: sha256=<firma>.
LEAD_WEBHOOK_SECRET=

# URL pública del sitio. Se usa para los enlaces de las notificaciones y del
# informe recuperable.
NEXT_PUBLIC_SITE_URL=

# --- Entrega del enlace del informe (Resend) ---
# API HTTP de Resend (POST https://api.resend.com/emails). No hay SMTP: Vercel
# no permite conexiones salientes por ese puerto.
# Capa gratuita: 3 000 correos/mes y 100/día; por debajo no tiene coste.
# Si RESEND_API_KEY o RESEND_FROM faltan, la app no promete ni ofrece el envío.
RESEND_API_KEY=
# Remitente verificado en Resend, con nombre y dominio: "TecRural <informes@tu-dominio>".
RESEND_FROM=
# Respuesta opcional (por ejemplo, el correo de contacto del responsable).
RESEND_REPLY_TO=

# --- Administración (opcional) ---
# Token para consultar leads vía GET /api/leads (header x-admin-token).
# Si no se define, el endpoint de listado responde 404.
ADMIN_TOKEN=

# HMAC para asociar cuotas semanales a un contacto (correo o teléfono) sin
# almacenar el dato en claro.
# Generar con un secreto aleatorio independiente de ADMIN_TOKEN.
CUOTA_TELEFONO_SECRET=

# --- Pruebas (no hace falta en producción) ---
# Base de datos para las pruebas de cuota. Deben borrar la tabla `cuotas` entre
# caso y caso, así que NO puede ser la de producción. Lo natural es una rama de
# Neon, que se crea desde la consola en un par de clics.
#   TEST_DATABASE_URL="postgres://.../neondb?..." npm test
TEST_DATABASE_URL=

# Escape para ejecutar las pruebas de cuota contra DATABASE_URL cuando no hay
# una base aparte. Solo tocan la tabla `cuotas`, así que no borran leads,
# diagnósticos ni eventos, pero SÍ reinician los contadores de cuota del día.
# Desactivado por defecto a propósito.
#   PERMITIR_TESTS_EN_PRODUCCION=1 npm test
PERMITIR_TESTS_EN_PRODUCCION=
