# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# PWA generated files
public/fallback-*.js

# Evaluación agronómica: imágenes y informes no se versionan (pueden contener
# datos de explotaciones). Mantén casos.json como plantilla.
/evaluacion/imagenes/
/evaluacion/informes/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local
